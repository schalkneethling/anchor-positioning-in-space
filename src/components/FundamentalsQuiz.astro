  function normalizeCssValue(value: string): string {
    return value
      .trim()
      .toLowerCase()
      .replace(/\s+/g, ' ')
      .replace(/\s*:\s*/g, ':')
      .replace(/\s*;\s*/g, ';')
      .replace(/;$/, '');
  }

  function createHint(answer: string): string {
    const trimmed = answer.trim();
    const midpoint = Math.max(Math.ceil(trimmed.length / 2), 8);
    return `${trimmed.slice(0, midpoint)}…`;
  }

  function shuffle<T>(items: T[]): T[] {
    const next = [...items];
    for (let index = next.length - 1; index > 0; index -= 1) {
      const swapIndex = Math.floor(Math.random() * (index + 1));
      [next[index], next[swapIndex]] = [next[swapIndex], next[index]];
    }
    return next;
  }

  function initQuiz(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('[data-stage]');
    const anchorEl = root.querySelector<HTMLElement>('[data-anchor]');
    const positionedEl = root.querySelector<HTMLElement>('[data-positioned]');
    const anchorTitle = root.querySelector<HTMLElement>('[data-anchor-title]');
    const anchorCopy = root.querySelector<HTMLElement>('[data-anchor-copy]');
    const positionedTitle = root.querySelector<HTMLElement>('[data-positioned-title]');
    const positionedCopy = root.querySelector<HTMLElement>('[data-positioned-copy]');
    const unsupported = root.querySelector<HTMLElement>('[data-unsupported]');
    const questionCount = root.querySelector<HTMLElement>('[data-question-count]');
    const scoreCount = root.querySelector<HTMLElement>('[data-score-count]');
    const questionType = root.querySelector<HTMLElement>('[data-question-type]');
    const questionPrompt = root.querySelector<HTMLElement>('[data-question-prompt]');
    const questionMeta = root.querySelector<HTMLElement>('[data-question-meta]');
    const choiceList = root.querySelector<HTMLElement>('[data-choice-list]');
    const inputBlock = root.querySelector<HTMLElement>('[data-input-block]');
    const answerInput = root.querySelector<HTMLInputElement>('[data-answer-input]');
    const hintBtn = root.querySelector<HTMLButtonElement>('[data-hint-btn]');
    const hintReveal = root.querySelector<HTMLElement>('[data-hint-reveal]');
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-submit-btn]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next-btn]');
    const restartBtn = root.querySelector<HTMLButtonElement>('[data-restart-btn]');
    const feedback = root.querySelector<HTMLElement>('[data-feedback]');
    const feedbackStatus = root.querySelector<HTMLElement>('[data-feedback-status]');
    const feedbackCopy = root.querySelector<HTMLElement>('[data-feedback-copy]');
    const learnMoreLink = root.querySelector<HTMLAnchorElement>('[data-learn-more-link]');
    const revealCode = root.querySelector<HTMLElement>('[data-reveal-code]');
    const summary = root.querySelector<HTMLElement>('[data-summary]');
    const summaryHeading = root.querySelector<HTMLElement>('[data-summary-heading]');
    const summaryCopy = root.querySelector<HTMLElement>('[data-summary-copy]');

    if (
      !stage ||
      !anchorEl ||
      !positionedEl ||
      !anchorTitle ||
      !anchorCopy ||
      !positionedTitle ||
      !positionedCopy ||
      !unsupported ||
      !questionCount ||
      !scoreCount ||
      !questionType ||
      !questionPrompt ||
      !questionMeta ||
      !choiceList ||
      !inputBlock ||
      !answerInput ||
      !hintBtn ||
      !hintReveal ||
      !submitBtn ||
      !nextBtn ||
      !restartBtn ||
      !feedback ||
      !feedbackStatus ||
      !feedbackCopy ||
      !learnMoreLink ||
      !revealCode ||
      !summary ||
      !summaryHeading ||
      !summaryCopy
    ) {
      return;
    }

    if (
      !CSS.supports('anchor-name', '--test') ||
      !CSS.supports('position-area', 'top')
    ) {
      stage.hidden = true;
      unsupported.hidden = false;
      submitBtn.disabled = true;
      nextBtn.disabled = true;
      restartBtn.disabled = true;
      hintBtn.disabled = true;
      answerInput.disabled = true;
      return;
    }

    const state = {
      run: [] as Question[],
      index: 0,
      score: 0,
      submitted: false,
      selectedChoice: -1,
      hintShown: false,
    };

    function getCurrentQuestion(): Question | undefined {
      return state.run[state.index];
    }

    function setScenario(question: Question) {
      const { scenario } = question;
      positionedEl.dataset.variant = scenario.variant;
      anchorTitle.textContent = scenario.anchorTitle;
      anchorCopy.textContent = scenario.anchorCopy;
      positionedTitle.textContent = scenario.positionedTitle;
      positionedCopy.textContent = scenario.positionedCopy;
      positionedEl.style.setProperty('position-area', scenario.area);
    }

    function renderChoices(question: MultipleChoiceQuestion) {
      choiceList.hidden = false;
      inputBlock.hidden = true;
      const groupName = `quiz-choice-${question.id}`;
      choiceList.innerHTML = question.choices
        .map(
          (choice, index) => `
            <div class="quiz-choice-option">
              <input
                class="quiz-choice-control"
                data-choice-index="${index}"
                type="radio"
                name="${groupName}"
                id="${groupName}-${index}"
                ${state.selectedChoice === index ? 'checked' : ''}
              />
              <label class="quiz-choice-label" for="${groupName}-${index}">
                <span class="quiz-choice-indicator" aria-hidden="true"></span>
                <span class="quiz-choice-text">${choice}</span>
              </label>
            </div>
          `,
        )
        .join('');

      choiceList.querySelectorAll<HTMLInputElement>('[data-choice-index]').forEach((input) => {
        input.addEventListener('change', () => {
          if (state.submitted) return;
          state.selectedChoice = Number(input.dataset.choiceIndex);
        });
      });
    }

    function renderTyped(question: TypedQuestion) {
      choiceList.hidden = true;
      inputBlock.hidden = false;
      answerInput.placeholder = 'Type a CSS declaration';
      answerInput.removeAttribute('aria-describedby');
      answerInput.value = '';
      hintReveal.hidden = true;
      hintReveal.textContent = '';
      hintBtn.hidden = false;
      if (!state.submitted) {
        answerInput.focus({ preventScroll: true });
      }
    }

    function renderCurrentQuestion() {
      const question = getCurrentQuestion();
      if (!question) return;

      if (state.index >= state.run.length) {
        return;
      }

      setScenario(question);
      questionCount.textContent = `${state.index + 1} / ${state.run.length}`;
      scoreCount.textContent = String(state.score);
      questionType.textContent = question.type === 'multiple-choice' ? 'Multiple choice' : 'Type the CSS';
      questionPrompt.textContent = question.prompt;
      questionMeta.textContent = question.meta;
      feedback.hidden = true;
      summary.hidden = true;
      submitBtn.hidden = false;
      nextBtn.hidden = true;
      restartBtn.hidden = true;
      state.hintShown = false;
      hintBtn.hidden = true;

      if (question.type === 'multiple-choice') {
        renderChoices(question);
      } else {
        renderTyped(question);
      }
    }

    function startRun() {
      state.run = shuffle(QUESTIONS).slice(0, 10);
      state.index = 0;
      state.score = 0;
      state.submitted = false;
      state.selectedChoice = -1;
      state.hintShown = false;
      renderCurrentQuestion();
    }

    function burstConfetti(originPosition?: { x: number; y: number }) {
      void confetti({
        count: 70,
        spread: 75,
        startVelocity: 42,
        decay: 0.92,
        gravity: 0.95,
        scalar: 0.95,
        ticks: 220,
        zIndex: 9999,
        position: originPosition
          ? {
              x: originPosition.x,
              y: originPosition.y,
            }
          : { x: 50, y: 22 },
        colors: ['#f28ecf', '#7bcfff', '#ffe082', '#9d4edd', '#7be39b'],
        disableForReducedMotion: true,
      });
    }

    function showFeedback(
      isCorrect: boolean,
      question: Question,
      triggerPosition?: { x: number; y: number },
    ) {
      feedback.hidden = false;
      feedback.dataset.tone = isCorrect ? 'success' : 'warning';
      feedbackStatus.textContent = isCorrect ? 'Correct answer' : 'Not quite';
      feedbackCopy.textContent = question.explanation;
      learnMoreLink.href = question.learnMore.href;
      learnMoreLink.textContent = question.learnMore.label;
      revealCode.textContent = question.revealCss;
      submitBtn.hidden = true;
      nextBtn.hidden = false;
      if (isCorrect) {
        burstConfetti(triggerPosition);
      }
    }

    function finishRun() {
      summary.hidden = false;
      summaryHeading.textContent =
        state.score >= 8 ? 'Strong fundamentals pass.' : 'Quiz run complete.';
      summaryCopy.textContent = `You answered ${state.score} of ${state.run.length} questions correctly. Start a new run for a fresh random set.`;
      feedback.hidden = true;
      choiceList.hidden = true;
      inputBlock.hidden = true;
      submitBtn.hidden = true;
      nextBtn.hidden = true;
      restartBtn.hidden = false;
      hintBtn.hidden = true;
      questionType.textContent = 'Results';
      questionPrompt.textContent = 'Review your score, then start a new run when you are ready.';
      questionMeta.textContent = 'Each new run draws a fresh set of 10 questions from the quiz bank.';
    }

    function gradeTypedAnswer(question: TypedQuestion): boolean {
      const normalizedInput = normalizeCssValue(answerInput.value);
      return question.acceptedAnswers.some((answer) => normalizeCssValue(answer) === normalizedInput);
    }

    hintBtn.addEventListener('click', () => {
      const question = getCurrentQuestion();
      if (!question || question.type !== 'typed-css' || state.submitted) return;

      state.hintShown = true;
      hintReveal.textContent = `Hint: ${createHint(question.acceptedAnswers[0])}`;
      hintReveal.hidden = false;
      hintBtn.hidden = true;
      answerInput.setAttribute('aria-describedby', hintReveal.id);
      answerInput.focus({ preventScroll: true });
    });

    submitBtn.addEventListener('click', () => {
      const question = getCurrentQuestion();
      if (!question || state.submitted) return;

      let isCorrect = false;

      if (question.type === 'multiple-choice') {
        if (state.selectedChoice < 0) {
          return;
        }
        isCorrect = state.selectedChoice === question.correctIndex;
      } else {
        if (!answerInput.value.trim()) {
          return;
        }
        isCorrect = gradeTypedAnswer(question);
      }

      const submitRect = submitBtn.getBoundingClientRect();
      const triggerPosition = {
        x: ((submitRect.left + submitRect.width / 2) / window.innerWidth) * 100,
        y: ((submitRect.top + submitRect.height / 2) / window.innerHeight) * 100,
      };

      state.submitted = true;
      if (isCorrect) {
        state.score += 1;
        scoreCount.textContent = String(state.score);
      }
      showFeedback(isCorrect, question, triggerPosition);
    });

    nextBtn.addEventListener('click', () => {
      state.index += 1;
      state.submitted = false;
      state.selectedChoice = -1;
      if (state.index >= state.run.length) {
        finishRun();
        return;
      }
      renderCurrentQuestion();
    });

    restartBtn.addEventListener('click', () => {
      startRun();
    });

    startRun();
  }

  document.querySelectorAll<HTMLElement>('[data-quiz-root]').forEach(initQuiz);
</script>
